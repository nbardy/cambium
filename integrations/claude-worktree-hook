#!/bin/sh
# Claude Code WorktreeCreate / WorktreeRemove hook backed by Cambium.
#
# In ~/.claude/settings.json (or a project's .claude/settings.json):
#
#   "hooks": {
#     "WorktreeCreate": [{"hooks": [{"type": "command",
#       "command": "/path/to/claude-worktree-hook create"}]}],
#     "WorktreeRemove": [{"hooks": [{"type": "command",
#       "command": "/path/to/claude-worktree-hook remove"}]}]
#   }
#
# Claude sends JSON on stdin and, for create, reads the worktree path from the
# single line this script prints on stdout. Worktrees go under
# $CLAUDE_WORKTREE_ROOT (default ~/.claude/worktrees). Needs jq, `cambium` and
# `git-cambium` on PATH.
set -eu

action=${1:?usage: claude-worktree-hook create|remove}
input=$(cat)

# Workspace names and paths use only these characters.
sanitize() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-'; }

case "$action" in
  create)
    name=$(sanitize "$(printf '%s' "$input" | jq -r '.name')")
    cwd=$(printf '%s' "$input" | jq -r '.cwd')
    base_ref=$(printf '%s' "$input" | jq -r '.base_ref // "head"')
    repo=$(git -C "$cwd" rev-parse --show-toplevel)
    # Cambium refuses worktrees inside the primary checkout, so Claude's usual
    # <repo>/.claude/worktrees is not available. Keep them next to each other
    # outside any repo, grouped per repository.
    root=${CLAUDE_WORKTREE_ROOT:-$HOME/.claude/worktrees}
    repo_id="$(basename "$repo")-$(printf '%s' "$repo" | shasum | cut -c1-8)"
    path="$root/$repo_id/$name"
    start=HEAD
    if [ "$base_ref" = fresh ] && git -C "$repo" rev-parse --verify -q origin/HEAD >/dev/null; then
      start=origin/HEAD
    fi
    mkdir -p "$root/$repo_id"
    # stdout is the hook's result, so keep Cambium's chatter on stderr.
    (cd "$repo" && git cambium add -b "worktree-$name" -name "claude-$name" -ephemeral "$path" "$start" >&2)
    printf '%s\n' "$path"
    ;;
  remove)
    # Claude Code sends the path as `worktree_path`. This script used to read
    # `.path`, got "null", failed the git lookup below and exited 0, so every
    # removal reported success while the directory and the Cambium record stayed
    # (found 2026-11-11). Exit 0 tells Claude the worktree is gone, so only exit 0
    # when it is.
    path=$(printf '%s' "$input" | jq -r '.worktree_path // .path // empty')
    if [ -z "$path" ]; then
      echo "claude-worktree-hook: no worktree_path in hook input" >&2
      exit 2
    fi
    name=$(basename "$path")
    if [ ! -e "$path" ]; then
      # Something else deleted the directory. `cambium remove` cannot verify a
      # worktree that is gone, and the leftover record keeps its baseline from
      # being pruned, so drop Git's registration for the missing path (if it
      # still has one) and the record. The repository comes from the session's
      # directory; if that is gone too there is nothing to find it by.
      cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
      common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
      cd "$(dirname "$common")"
      git worktree remove "$path" >/dev/null 2>&1 || true
      cambium forget "claude-$name" >&2 || true
      exit 0
    fi
    # The directory exists. If it is not a worktree, fail so Claude keeps it.
    common=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)
    repo=$(dirname "$common")
    cd "$repo"
    # Without --force Cambium refuses a workspace with uncommitted work; the
    # non-zero exit then makes Claude keep the worktree.
    cambium remove "claude-$name" >&2
    git branch -d "worktree-$name" >/dev/null 2>&1 || true
    ;;
  *)
    echo "unknown action: $action" >&2
    exit 2
    ;;
esac
